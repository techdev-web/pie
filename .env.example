# Database
DATABASE_URL=postgresql+asyncpg://pie:pie@localhost:55432/pie

# Redis / arq
REDIS_URL=redis://localhost:6379/0

# Object storage. Default local FS for Phase 0/1; set STORAGE_BACKEND=s3 with MinIO profile.
STORAGE_BACKEND=fs
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=pie_minio
S3_SECRET_KEY=pie_minio_secret
S3_BUCKET=pie-documents
S3_REGION=us-east-1
FS_STORAGE_PATH=./data/storage

# AI — leave empty to use MockProvider
GEMINI_API_KEY=
GEMINI_CLASSIFY_MODEL=gemini-2.5-flash
GEMINI_OCR_MODEL=gemini-2.5-flash
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro
GEMINI_EMBED_MODEL=gemini-embedding-001

# Cost budgets (USD / month default)
COST_BUDGET_DEFAULT_USD=50.0
COST_BUDGET_ALERT_THRESHOLD_PCT=80
STAGE_TIMEOUT_SECONDS=120
WORKER_MAX_TRIES=3

# App
PIE_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Dev seed (created by `pie-seed` / scripts/seed)
# After seeding, use this key in X-API-Key header or the web UI
PIE_API_KEY=pie_dev_key_change_me
